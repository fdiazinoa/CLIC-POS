# ==============================================
# CLIC-POS Configuration
# ==============================================

# Server Mode
# - 'false' = HTTP para red local (desarrollo y producción local)
# - 'true'  = HTTPS para ERP en la nube
CLOUD_MODE=false

# Server Port & Host
PORT=3001
HOST=0.0.0.0

# SSL Certificates (solo requerido cuando CLOUD_MODE=true)
# Descomentar y configurar rutas para deployment en cloud:
# SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem
# SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem

# API Keys
GEMINI_API_KEY=your_api_key_here

# Frontend Flags
# Enable legacy NetworkSyncService (deprecated). Default is false.
VITE_ENABLE_NETWORK_SYNC=false

# Supabase (Cloud Activation)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
VITE_SQLITE_OUTBOX_V2_ENABLED=false
VITE_CLOUD_ADMIN_URL=https://cloud-admin-gamma.vercel.app

# Optional override for tenant provisioning endpoint.
# If omitted, frontend uses ${VITE_CLOUD_ADMIN_URL}/api/activation
VITE_ACTIVATION_API_BASE_URL=

# ERP sync lifecycle endpoint
# Example: https://clic-erp.clicsuite.com/api/sync
VITE_SYNC_API_URL=

# Server-side provisioning (for /api/activation/provision-tenant in local web mode)
# Keep this key only in server environment.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_sb_secret_key
