buffers { size_kb: 65536 fill_policy: RING_BUFFER }
buffers { size_kb: 16384 fill_policy: RING_BUFFER }
duration_ms: 45000
write_into_file: true
file_write_period_ms: 1000
flush_period_ms: 5000
max_file_size_bytes: 268435456
data_sources { config { name: "linux.ftrace" target_buffer: 0 ftrace_config {
  ftrace_events: "sched/sched_switch"
  ftrace_events: "sched/sched_wakeup"
  ftrace_events: "sched/sched_waking"
  ftrace_events: "power/cpu_frequency"
  ftrace_events: "power/cpu_idle"
  ftrace_events: "binder/binder_transaction"
  ftrace_events: "binder/binder_transaction_received"
  atrace_categories: "gfx"
  atrace_categories: "view"
  atrace_categories: "webview"
  atrace_categories: "input"
  atrace_categories: "dalvik"
  atrace_categories: "database"
  atrace_categories: "am"
  atrace_categories: "wm"
  atrace_apps: "com.clicpos.app"
  compact_sched { enabled: true }
} } }
data_sources { config { name: "linux.process_stats" target_buffer: 1 process_stats_config { scan_all_processes_on_start: true proc_stats_poll_ms: 1000 } } }
data_sources { config { name: "android.surfaceflinger.frametimeline" target_buffer: 0 } }
data_sources { config { name: "android.log" target_buffer: 1 android_log_config { filter_tags: "POS_DIAG_JS" filter_tags: "POS_DIAG_NATIVE" filter_tags: "POS_DIAG_FRAME" } } }
data_sources { config { name: "track_event" target_buffer: 0 track_event_config {
 disabled_categories: "*"
 enabled_categories: "toplevel"
 enabled_categories: "blink.user_timing"
 enabled_categories: "devtools.timeline"
 enabled_categories: "v8"
 enabled_categories: "blink"
 enabled_categories: "v8.execute"
} chrome_config { trace_config: "{\"record_mode\":\"record-until-full\",\"included_categories\":[\"toplevel\",\"blink.user_timing\",\"devtools.timeline\",\"v8\",\"v8.execute\",\"blink\"]}" } }
producer_name_regex_filter: "org.chromium-com.clicpos.app-.*"
}
